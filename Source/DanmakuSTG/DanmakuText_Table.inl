// Generated by Tools/loc/make_table.py from Tools/loc/en.txt. Do not edit by hand.
{ TEXT("天狼"), TEXT("Tenrou") },
{ TEXT("星詠陰陽師"), TEXT("Star-Chanting Onmyoji") },
{ TEXT("第一面"), TEXT("Stage 1") },
{ TEXT("星光參道"), TEXT("Starlit Shrine Path") },
{ TEXT("日輪「赫耀天環」"), TEXT("Sun Wheel \"Blazing Heaven Ring\"") },
{ TEXT("月蝕「月面反照」"), TEXT("Lunar Eclipse \"Moonlit Reflection\"") },
{ TEXT("星雨「天河崩落」"), TEXT("Star Rain \"Fall of the Heavenly River\"") },
{ TEXT("日月星奧義「終夜天象」"), TEXT("Sun-Moon-Star Secret Art \"Night-Long Firmament\"") },
{ TEXT("神社派來的，竟是個追著星星跑的少年。"), TEXT("So the shrine sent a boy who chases stars.") },
{ TEXT("村子上空的星座全都熄滅了。是你做的吧？"), TEXT("Every constellation over the village has gone dark. That was you, wasn't it?") },
{ TEXT("我只是借來占卜。星象說，七夜之後「天門」將開……我必須看清楚。"), TEXT("I only borrowed them for a reading. The stars say that in seven nights the \"Heaven's Gate\" will open... I must see it clearly.") },
{ TEXT("管你什麼天門，先把星星還回來！"), TEXT("I don't care about any gate! Give the stars back first!") },
{ TEXT("好大的口氣。就讓我看看，你的命運能否熬過這片星圖！"), TEXT("Big words. Let's see if your fate can survive this star chart!") },
{ TEXT("又一個來找星星的？這次是個帶弓的。"), TEXT("Another one looking for the stars? An archer this time.") },
{ TEXT("星座熄了，村裡的占卜全亂了。還回來。"), TEXT("The constellations are out and the village readings are a mess. Give them back.") },
{ TEXT("夜裡有聲音要我讀星。天門將開，我得把整片夜空攤開來看。"), TEXT("A voice in the night told me to read the stars. The Gate will open, so I have to spread the whole sky out and look.") },
{ TEXT("話真多。我只需要一箭。"), TEXT("You talk too much. I only need one arrow.") },
{ TEXT("那就看看你的箭，能不能射穿這片星圖！"), TEXT("Then let's see whether your arrow can pierce this star chart!") },
{ TEXT("山伏？深夜爬到參道上，不怕迷路嗎？"), TEXT("A mountain monk? Climbing the shrine path this late, aren't you afraid of getting lost?") },
{ TEXT("星星都不見了，我連回家的方向都看不到啦～"), TEXT("The stars are gone, so I can't even find my way home~") },
{ TEXT("我借來占卜罷了。夢裡有個聲音說，天門將開，要我讀盡星象。"), TEXT("I just borrowed them for a reading. A voice in a dream said the Gate will open and told me to read every star.") },
{ TEXT("夢裡的聲音？那你有沒有夢到晚飯？"), TEXT("A voice in a dream? Did you dream about dinner too?") },
{ TEXT("……真是奇怪的傢伙。也罷，讓星圖決定你的命運！"), TEXT("...What a strange one. Fine, let the star chart decide your fate!") },
{ TEXT("提著人偶的少年……你也是神社派來的？"), TEXT("A boy carrying puppets... Did the shrine send you too?") },
{ TEXT("星光消失之後，孩子們一直在哭。……對吧，小紙？"), TEXT("Since the starlight vanished, the children have been crying. ...Right, Kogami?") },
{ TEXT("有聲音在夢裡告訴我：天門將開，要我看清所有星辰。"), TEXT("A voice in my dream told me: the Gate will open, and I must see every star.") },
{ TEXT("那麼，請先把星星還給天空。孩子們……準備好了。"), TEXT("Then please give the stars back to the sky. Children... get ready.") },
{ TEXT("好啊，讓我看看人偶的命運，熬不熬得過這片星圖！"), TEXT("All right, let's see if a puppet's fate can survive this star chart!") },
{ TEXT("千秋"), TEXT("Chiaki") },
{ TEXT("四季流轉的畫師"), TEXT("Painter of the Turning Seasons") },
{ TEXT("第二面"), TEXT("Stage 2") },
{ TEXT("四時繪卷"), TEXT("Scroll of the Four Seasons") },
{ TEXT("春符「春風催生」"), TEXT("Spring Sign \"Spring Wind of Growth\"") },
{ TEXT("夏符「夏日鋒芒」"), TEXT("Summer Sign \"Edge of the Summer Sun\"") },
{ TEXT("秋符「秋風落葉」"), TEXT("Autumn Sign \"Falling Leaves in the Autumn Wind\"") },
{ TEXT("冬符「冬日暴雪」"), TEXT("Winter Sign \"Winter Blizzard\"") },
{ TEXT("別動。你正站在我還沒乾的顏料上。"), TEXT("Don't move. You're standing on paint that hasn't dried.") },
{ TEXT("這片山谷的季節亂成一團，是你畫的？"), TEXT("The seasons in this valley are all jumbled up. Did you paint this?") },
{ TEXT("夢裡有人對我說：「四季將散，畫下它們。」所以我把春夏秋冬都收進了這一幅畫。"), TEXT("Someone in a dream said to me: \"The four seasons will scatter. Paint them.\" So I put spring, summer, autumn and winter into this one painting.") },
{ TEXT("又是夢裡的聲音？前面那個占星師也這麼說！"), TEXT("A voice in a dream again? That stargazer said the same thing!") },
{ TEXT("咦，他也聽見了？……不管了，畫還沒完成，我不能停筆！"), TEXT("Oh, he heard it too? ...Never mind, the painting isn't finished. I can't put down my brush!") },
{ TEXT("那我就把你的畫筆打下來！"), TEXT("Then I'll knock that brush out of your hand!") },
{ TEXT("啊，弓手！你拉弓的姿勢真美，能讓我畫一張嗎？"), TEXT("Ah, an archer! Your stance is beautiful. May I paint you?") },
{ TEXT("不能。把季節還原。"), TEXT("No. Put the seasons back.") },
{ TEXT("不行喔。有個聲音說四季就要散了，我得趁現在把它們全畫下來。"), TEXT("I can't. A voice said the seasons are about to scatter, so I have to paint them all while I can.") },
{ TEXT("跟占星師一樣的說詞。誰在背後說話？"), TEXT("Same story as the stargazer. Who's talking behind all this?") },
{ TEXT("我也不知道。可是那聲音……很溫柔，也很疲憊。"), TEXT("I don't know either. But that voice... was gentle, and very tired.") },
{ TEXT("疲憊的是我。開始吧。"), TEXT("I'm the one who's tired. Let's begin.") },
{ TEXT("你踩到我的顏料了……啊，算了，顏色挺好看。"), TEXT("You stepped on my paint... oh, never mind, the colour looks nice.") },
{ TEXT("這裡又開櫻花又落楓葉，山上的柿子都不知道該不該熟了～"), TEXT("Cherry blossoms blooming and maple leaves falling at once... the persimmons on the hill don't know whether to ripen~") },
{ TEXT("夢裡有人拜託我，在四季散掉之前把它們畫下來。我只是聽話而已。"), TEXT("Someone in a dream asked me to paint the seasons before they scatter. I'm just doing as I was told.") },
{ TEXT("你也做夢？最近大家都好愛做夢喔。"), TEXT("You dream too? Everyone's been dreaming a lot lately.") },
{ TEXT("大家？……難道不只我一個？"), TEXT("Everyone? ...So it isn't just me?") },
{ TEXT("先不管啦，我想吃秋天的柿子，不想吃冰的！"), TEXT("Forget that, I want autumn persimmons, not frozen ones!") },
{ TEXT("好安靜的孩子。你的人偶……也想入畫嗎？"), TEXT("What a quiet child. Do your puppets... want to be in the painting too?") },
{ TEXT("它們說，這裡的季節亂得讓人頭暈。"), TEXT("They say the seasons here are so jumbled it makes them dizzy.") },
{ TEXT("我是照著夢裡的聲音畫的。它說：「四季將散，請留住它們。」"), TEXT("I painted as the voice in my dream told me. It said: \"The seasons will scatter. Please keep them.\"") },
{ TEXT("天狼先生也說，他聽見了聲音……是同一個人嗎？"), TEXT("Mr. Tenrou said he heard a voice too... Is it the same person?") },
{ TEXT("也許吧。那聲音聽起來，像是快要消失了。"), TEXT("Perhaps. That voice sounded like it was about to fade away.") },
{ TEXT("……那麼，就讓孩子們先把季節還回去吧。"), TEXT("...Then let the children return the seasons first.") },
{ TEXT("嵐"), TEXT("Arashi") },
{ TEXT("呼風喚雨的天氣師"), TEXT("Weather Master of Wind and Rain") },
{ TEXT("第三面"), TEXT("Stage 3") },
{ TEXT("雲上之路"), TEXT("Road Above the Clouds") },
{ TEXT("晴符「晴空萬里」"), TEXT("Clear Sign \"Ten Thousand Miles of Blue Sky\"") },
{ TEXT("雨符「雨幕延綿」"), TEXT("Rain Sign \"Endless Curtain of Rain\"") },
{ TEXT("雷符「雷暴中心」"), TEXT("Thunder Sign \"Eye of the Storm\"") },
{ TEXT("霧符「雲裡霧裡」"), TEXT("Fog Sign \"Lost in the Clouds\"") },
{ TEXT("誰准你飛上我的雲海的？給我滾下去！"), TEXT("Who said you could fly into my sea of clouds? Get down from there!") },
{ TEXT("山下連下了七天大雨，你就是罪魁禍首吧！"), TEXT("It's rained for seven days down the mountain. You're the culprit, aren't you!") },
{ TEXT("哼，是天上的聲音叫我聚雲的！不過我嵐可不是聽命行事——我是剛好想下雨！"), TEXT("Hmph, a voice from above told me to gather clouds! But I, Arashi, don't just follow orders. I happened to feel like rain!") },
{ TEXT("天上的聲音……占星師和畫師也聽到了。到底是誰？"), TEXT("A voice from above... the stargazer and the painter heard it too. Who is it?") },
{ TEXT("我怎麼知道！只知道我聚起的雲，全被吸進更高的天上去了。"), TEXT("How should I know! All I know is that the clouds I gather get sucked up into the higher sky.") },
{ TEXT("有人在收集力量……？"), TEXT("Someone is collecting power...?") },
{ TEXT("少囉嗦！先撐過我的雷再說吧！"), TEXT("Enough talk! Survive my thunder first!") },
{ TEXT("又來一個不怕雷劈的小鬼。"), TEXT("Another brat who isn't afraid of lightning.") },
{ TEXT("你的雷劈壞了三座神社。賠吧。"), TEXT("Your lightning wrecked three shrines. Pay for them.") },
{ TEXT("要賠找天上那傢伙賠！是他在我耳邊嘀咕，要我把雲聚起來的！"), TEXT("Make the guy upstairs pay! He's the one muttering in my ear to gather clouds!") },
{ TEXT("你聚起來的雲，往上飄走了。"), TEXT("The clouds you gathered drifted upward.") },
{ TEXT("……你也注意到了？我的雲，一直被什麼東西往天頂吸。真不爽。"), TEXT("...You noticed too? Something keeps pulling my clouds toward the zenith. It's annoying.") },
{ TEXT("那就先打完，再一起上去看。"), TEXT("Then we finish this first, and go up together.") },
{ TEXT("喂！雲是給你坐的嗎！快起來！"), TEXT("Hey! Are clouds for sitting on? Get up!") },
{ TEXT("好軟喔～在這裡睡午覺一定很舒服。"), TEXT("It's so soft~ A nap up here would be perfect.") },
{ TEXT("我是天氣之主嵐！你給我認真一點！"), TEXT("I am Arashi, lord of the weather! Take me seriously!") },
{ TEXT("好啦好啦。那天氣之主，為什麼一直下雨呢？"), TEXT("Okay, okay. So, lord of the weather, why won't the rain stop?") },
{ TEXT("……天上有個聲音叫我聚雲。可是聚越多，雲就被吸走越多，我只好拼命再聚！"), TEXT("...A voice up there told me to gather clouds. But the more I gather, the more gets taken, so I keep gathering like mad!") },
{ TEXT("喔～所以你是被拿走雲才生氣的啊。"), TEXT("Oh~ So you're angry because someone's taking your clouds.") },
{ TEXT("閉嘴！想要晴天？先淋一場暴雨吧！"), TEXT("Shut up! You want sunshine? Take a downpour first!") },
{ TEXT("小鬼，帶著一堆布娃娃跑到雲上幹什麼？"), TEXT("Kid, what are you doing up in the clouds with a pile of dolls?") },
{ TEXT("雨下太久了……孩子們的衣服一直都乾不了。"), TEXT("It's rained too long... the children's clothes never dry.") },
{ TEXT("哼，那你去跟天上的聲音抱怨！是它要我聚雲的。"), TEXT("Hmph, go complain to the voice in the sky! It's the one that told me to gather clouds.") },
{ TEXT("占星師、畫師、還有您……大家都聽見同一個聲音。"), TEXT("The stargazer, the painter, and you... everyone heard the same voice.") },
{ TEXT("是又怎樣？那聲音一直說「時間不多了」，聽了就煩！"), TEXT("So what? That voice keeps saying \"there isn't much time.\" It's driving me nuts!") },
{ TEXT("……時間不多了。孩子們，我們得快一點。"), TEXT("...There isn't much time. Children, we have to hurry.") },
{ TEXT("墨竹"), TEXT("Bokuchiku") },
{ TEXT("四君子的書生"), TEXT("Scholar of the Four Gentlemen") },
{ TEXT("第四面"), TEXT("Stage 4") },
{ TEXT("四君子庭園"), TEXT("Garden of the Four Gentlemen") },
{ TEXT("梅符「梅花盛開」"), TEXT("Plum Sign \"Plum Blossoms in Full Bloom\"") },
{ TEXT("蘭符「蘭花路徑」"), TEXT("Orchid Sign \"Orchid Path\"") },
{ TEXT("竹符「竹林之勢」"), TEXT("Bamboo Sign \"Force of the Bamboo Grove\"") },
{ TEXT("菊符「菊花之哀」"), TEXT("Chrysanthemum Sign \"Sorrow of the Chrysanthemum\"") },
{ TEXT("四君子「君子之約」"), TEXT("Four Gentlemen \"The Gentlemen's Pact\"") },
{ TEXT("擅闖庭園，實屬無禮。閣下所為何事？"), TEXT("Trespassing in this garden is most discourteous. What is your business?") },
{ TEXT("山裡的花草全都朝這裡長，是你搞的鬼吧？"), TEXT("Every plant on the mountain is growing toward this place. That's your doing, isn't it?") },
{ TEXT("在下奉「天命」聚集草木靈氣。天門開啟之時，山之靈氣將會散盡。"), TEXT("I gather the spirit of the plants by \"Heaven's decree\". When the Heaven's Gate opens, the mountain's spirit will scatter.") },
{ TEXT("又是天上的聲音！占星師、畫師、天氣師……大家都被它使喚！"), TEXT("The voice from above again! The stargazer, the painter, the weather master... it's ordering everyone around!") },
{ TEXT("星辰、四時、天候、草木——閣下可曾想過，這四者合起來是什麼？"), TEXT("Stars, seasons, weather, plants. Have you ever wondered what the four make together?") },
{ TEXT("……什麼？"), TEXT("...What?") },
{ TEXT("是撐起「天地結界」之氣。有人在收集它們。五行仙壇的玄，或許知道得更多。"), TEXT("The breath that holds up the barrier between heaven and earth. Someone is collecting them. Gen of the Five Elements Altar may know more.") },
{ TEXT("那我先打贏你，再去問他！"), TEXT("Then I'll beat you first and go ask him!") },
{ TEXT("持弓而來，殺氣太重，有失風雅。"), TEXT("Arriving bow in hand, with such killing intent. Most inelegant.") },
{ TEXT("你把山裡的靈氣都吸走了。"), TEXT("You drained all the spirit from the mountain.") },
{ TEXT("在下奉天命行事。只是近日越想越覺不妥。"), TEXT("I act on Heaven's decree. But lately, the more I think, the less right it feels.") },
{ TEXT("說。"), TEXT("Speak.") },
{ TEXT("星、季、天候、靈氣，皆被引往天頂。有人在補一道破損的結界。"), TEXT("Stars, seasons, weather and spirit are all being drawn to the zenith. Someone is mending a broken barrier.") },
{ TEXT("誰？"), TEXT("Who?") },
{ TEXT("不知。但五行仙壇的方士玄，定然知情。——在此之前，請先賜教。"), TEXT("I do not know. But Gen, the sorcerer of the Five Elements Altar, surely does. Before that, however, please grant me a match.") },
{ TEXT("這位修行者，入園請先脫鞋。"), TEXT("Traveller, please remove your shoes before entering the garden.") },
{ TEXT("啊，抱歉抱歉～你家竹子長得真好，筍子能吃嗎？"), TEXT("Oh, sorry, sorry~ Your bamboo grows so well. Can I eat the shoots?") },
{ TEXT("……竹乃君子，豈可食之。"), TEXT("...Bamboo is a gentleman. One does not eat it.") },
{ TEXT("可是很好吃耶。對了，你也是聽了夢裡的聲音才這樣的吧？"), TEXT("But it's tasty! Oh, and you're doing this because of a voice in a dream too, right?") },
{ TEXT("……閣下怎會知道？那聲音說，天門將開，山靈將散，要在下守住它們。"), TEXT("...How did you know? The voice said the Gate will open and the mountain's spirit will scatter, and told me to guard it.") },
{ TEXT("大家都這麼說耶。占星的、畫畫的、下雨的……好像有人在湊齊什麼東西。"), TEXT("Everyone says that! The star one, the painting one, the rainy one... It's like someone's collecting a set.") },
{ TEXT("湊齊……原來如此。若想知道答案，去問五行仙壇的玄吧。不過，得先過在下這一關！"), TEXT("A set... I see. If you want answers, ask Gen of the Five Elements Altar. But first, you must get past me!") },
{ TEXT("有禮的客人。是來賞花的嗎？"), TEXT("A courteous guest. Have you come to view the flowers?") },
{ TEXT("是的……也想請您，把山的靈氣還回去。"), TEXT("Yes... and to ask you to return the mountain's spirit.") },
{ TEXT("在下是奉天命而為。天門開啟時，靈氣將散，必須有人守住。"), TEXT("I act on Heaven's decree. When the Gate opens the spirit will scatter, and someone must guard it.") },
{ TEXT("孩子們說，星星、四季、雲……還有這裡的靈氣，都流向同一個地方。"), TEXT("The children say the stars, the seasons, the clouds... and the spirit here all flow to the same place.") },
{ TEXT("好敏銳的人偶。沒錯，全都流向天頂，像在修補什麼。"), TEXT("Such perceptive puppets. Yes, it all flows to the zenith, as if mending something.") },
{ TEXT("修補……結界嗎？"), TEXT("Mending... a barrier?") },
{ TEXT("或許。五行仙壇的方士玄，比誰都清楚天上的事。"), TEXT("Perhaps. Gen, the sorcerer of the Five Elements Altar, knows the affairs of heaven better than anyone.") },
{ TEXT("那麼，請讓孩子們先過去。"), TEXT("Then please let the children through.") },
{ TEXT("……梅蘭竹菊，竟都敗在你手上。在下服了。"), TEXT("...Plum, orchid, bamboo and chrysanthemum, all defeated by you. I concede.") },
{ TEXT("你也聽到那個聲音了吧？到底是誰？"), TEXT("You heard that voice too, right? Who is it?") },
{ TEXT("在下只知，那聲音來自天上。它說靈氣齊聚之時，「門」便會開。"), TEXT("I only know that it comes from the sky. It said that when the spirits gather, the \"Gate\" will open.") },
{ TEXT("往五行仙壇去吧。玄……那個人或許知道得更多。"), TEXT("Go to the Five Elements Altar. Gen... he may know more.") },
{ TEXT("好！謝啦，書呆子！"), TEXT("Great! Thanks, bookworm!") },
{ TEXT("……書、書呆子？"), TEXT("...B-bookworm?") },
{ TEXT("好箭法。君子不爭，在下卻爭輸了。"), TEXT("Fine archery. A gentleman does not compete, yet I competed and lost.") },
{ TEXT("那聲音，你知道多少。"), TEXT("That voice. How much do you know?") },
{ TEXT("不多。只知它對每個人說的話都不一樣，卻都指向同一個夜晚——天門之夜。"), TEXT("Not much. Only that it says something different to each of us, yet it all points to the same night: the Night of the Heaven's Gate.") },
{ TEXT("下一個是誰？"), TEXT("Who's next?") },
{ TEXT("五行仙壇的方士，玄。他說話如謎，閣下……請耐著性子聽。"), TEXT("The sorcerer of the Five Elements Altar, Gen. He speaks in riddles, so... please be patient with him.") },
{ TEXT("我盡量。"), TEXT("I'll try.") },
{ TEXT("輸了。在下的庭園，被你踩得一塌糊塗。"), TEXT("I lost. And you trampled my garden into a mess.") },
{ TEXT("對不起嘛～不過這裡的梅子好像很好吃耶！"), TEXT("Sorry~ But the plums here look really tasty!") },
{ TEXT("……那要等結果才能吃。言歸正傳，你身上有不尋常的靈氣。"), TEXT("...They must bear fruit before you can eat them. Back to the point: there is an unusual spirit in you.") },
{ TEXT("咦？是剛剛吃的饅頭嗎？"), TEXT("Huh? Is it the bun I just ate?") },
{ TEXT("不是。是星辰、四季、天候……還有剛從在下身上流走的靈氣。你正一路收集它們。"), TEXT("No. Stars, seasons, weather... and the spirit that just flowed out of me. You are collecting them as you go.") },
{ TEXT("收集到最後會怎樣？"), TEXT("What happens when I collect them all?") },
{ TEXT("在下不知道。去問五行仙壇的玄吧。"), TEXT("I do not know. Ask Gen at the Five Elements Altar.") },
{ TEXT("人偶師，你贏了。在下的四君子，都向你低頭。"), TEXT("Puppeteer, you win. My four gentlemen all bow to you.") },
{ TEXT("孩子們說……您的花，其實很溫柔。"), TEXT("The children say... your flowers are actually very gentle.") },
{ TEXT("……多謝。那聲音要在下守住靈氣，等一個人來取。現在想來，等的或許就是你。"), TEXT("...Thank you. The voice told me to guard the spirit until someone came to take it. Now I think it was waiting for you.") },
{ TEXT("等我……？"), TEXT("Waiting... for me?") },
{ TEXT("往五行仙壇吧。玄看得比在下遠。"), TEXT("Go to the Five Elements Altar. Gen sees further than I do.") },
{ TEXT("孩子們，我們走吧。"), TEXT("Children, let's go.") },
{ TEXT("玄"), TEXT("Gen") },
{ TEXT("五行的方士"), TEXT("Sorcerer of the Five Elements") },
{ TEXT("第五面"), TEXT("Stage 5") },
{ TEXT("五行仙壇"), TEXT("Five Elements Altar") },
{ TEXT("木符「萬木生長」"), TEXT("Wood Sign \"Growth of Ten Thousand Trees\"") },
{ TEXT("火符「烈火燎原」"), TEXT("Fire Sign \"Wildfire on the Plains\"") },
{ TEXT("土符「山崩地裂」"), TEXT("Earth Sign \"Landslide and Earthquake\"") },
{ TEXT("金符「金戈鐵刃」"), TEXT("Metal Sign \"Spears and Iron Blades\"") },
{ TEXT("水符「流水無形」"), TEXT("Water Sign \"Formless Flowing Water\"") },
{ TEXT("五行「相生相剋」"), TEXT("Five Elements \"Creation and Destruction\"") },
{ TEXT("你來了。比卦象晚了一刻。"), TEXT("You've come. A moment later than the divination said.") },
{ TEXT("你一定知道吧！那個在夢裡下命令的聲音是誰？"), TEXT("You must know! Whose is the voice giving orders in our dreams?") },
{ TEXT("天宮的守護者，燁。守護這片土地的「四神結界」正在崩壞，而他的力量也快耗盡了。"), TEXT("Yoh, guardian of the Heavenly Palace. The \"Four Gods Barrier\" protecting this land is collapsing, and his strength is nearly spent.") },
{ TEXT("所以他讓大家收集星辰、四季、天候、靈氣……"), TEXT("So he made everyone collect stars, seasons, weather, spirit...") },
{ TEXT("再加上我的五行。可是他從沒說原因——因為真正的目的，不是讓我們收集。"), TEXT("And my five elements. But he never told us why, because the real purpose was never for us to collect them.") },
{ TEXT("那是什麼？"), TEXT("Then what was it?") },
{ TEXT("是讓「打倒我們的人」收集。你每贏一場，那份力量就流進你的身體。你，就是他在等的容器。"), TEXT("For \"whoever defeats us\" to collect them. Each time you win, that power flows into your body. You are the vessel he has been waiting for.") },
{ TEXT("……我才不管什麼容器！我要親口問他！"), TEXT("...I don't care about any vessel! I'll ask him myself!") },
{ TEXT("呵……那就證明你裝得下第五份力量吧。"), TEXT("Heh... Then prove you can hold a fifth power.") },
{ TEXT("你的箭，屬金。"), TEXT("Your arrows belong to metal.") },
{ TEXT("我沒空聽卦。在背後下令的是誰？"), TEXT("I don't have time for fortunes. Who's giving the orders?") },
{ TEXT("天宮的燁。四神結界的守護者。他快撐不住了，所以向五個人發了天啟。"), TEXT("Yoh of the Heavenly Palace, guardian of the Four Gods Barrier. He can barely hold on, so he sent revelations to five people.") },
{ TEXT("要大家收集力量？"), TEXT("To make everyone collect power?") },
{ TEXT("不。要大家「被打倒」。每一位守門人倒下，力量就會移到勝者身上。"), TEXT("No. To make everyone \"be defeated\". When each gatekeeper falls, the power moves to the victor.") },
{ TEXT("……所以我一路射下來的，全是他的棋。"), TEXT("...So everyone I shot down along the way was one of his pieces.") },
{ TEXT("正是。而我是最後一顆棋子。來吧，把五行也拿走。"), TEXT("Exactly. And I am the last piece. Come, take the five elements too.") },
{ TEXT("棋也好，靶也好。我照射不誤。"), TEXT("Piece or target, I shoot all the same.") },
{ TEXT("山伏也懂五行？"), TEXT("A mountain monk who knows the five elements?") },
{ TEXT("懂一點點～木頭可以生火烤地瓜，火可以煮水泡茶！"), TEXT("A little~ Wood makes fire to roast sweet potatoes, and fire boils water for tea!") },
{ TEXT("……倒也沒錯。萬物相生，循環不息。那你可知道，你身上已經背了四份力量？"), TEXT("...Not wrong. All things give rise to one another, endlessly. But did you know you already carry four powers?") },
{ TEXT("咦？難怪我最近一直很餓！"), TEXT("Huh? No wonder I've been so hungry lately!") },
{ TEXT("呵。那是星辰、四時、天候、靈氣。全是天宮的燁安排的——他要找一個能扛起四神結界的人。"), TEXT("Heh. Stars, seasons, weather and spirit. All arranged by Yoh of the Heavenly Palace. He is looking for someone who can carry the Four Gods Barrier.") },
{ TEXT("結界？壞掉了嗎？"), TEXT("The barrier? Is it broken?") },
{ TEXT("快碎了。燁也快消失了。所以他用天啟讓我們引起異變，好讓你一路收集。"), TEXT("Nearly shattered. And Yoh is nearly gone. So he used revelations to make us cause incidents, so that you would collect the powers one by one.") },
{ TEXT("好過分喔，那等一下要罵他一頓！"), TEXT("That's so mean! I'll scold him later!") },
{ TEXT("先過了我這關吧。來，把五行也背上。"), TEXT("First get past me. Come, carry the five elements as well.") },
{ TEXT("人偶師。你的人偶，屬木還是屬土？"), TEXT("Puppeteer. Do your puppets belong to wood, or to earth?") },
{ TEXT("它們……屬於我。請告訴我，那個聲音的主人是誰。"), TEXT("They... belong to me. Please tell me who the voice belongs to.") },
{ TEXT("天宮的守護者，燁。四神結界將碎，他也將盡。"), TEXT("Yoh, guardian of the Heavenly Palace. The Four Gods Barrier will shatter, and he will fade with it.") },
{ TEXT("所以大家才……"), TEXT("So that's why everyone...") },
{ TEXT("是他讓我們引起異變，讓你一路取走我們的力量。你已經是他選中的容器。"), TEXT("He had us cause incidents so that you would take our powers one by one. You are already the vessel he chose.") },
{ TEXT("孩子們說，那聲音一直都很寂寞。"), TEXT("The children say that voice has always been very lonely.") },
{ TEXT("……人偶看得比人清楚。那麼，接下第五份吧——五行之中沒有例外。"), TEXT("...Puppets see more clearly than people. Then take the fifth. Among the five elements there are no exceptions.") },
{ TEXT("孩子們，我們會好好帶上去的。"), TEXT("Children, we'll carry it up carefully.") },
{ TEXT("五行已盡……卦象說得沒錯，你裝得下。"), TEXT("The five elements are spent... The divination was right. You can hold them.") },
{ TEXT("身體好熱……這就是五份力量？"), TEXT("My body's burning... Is this the five powers?") },
{ TEXT("是。天宮就在雲上。燁等的，就是現在的你。"), TEXT("Yes. The Heavenly Palace lies above the clouds. Yoh has been waiting for you, as you are now.") },
{ TEXT("你們被他利用，不生氣嗎？"), TEXT("He used all of you. Aren't you angry?") },
{ TEXT("生氣？呵……我們都夢到了同一個將要崩塌的世界。若能撐住它，當一顆棋子也無妨。"), TEXT("Angry? Heh... We all dreamed of the same world about to collapse. If it can be held up, being a game piece is no shame.") },
{ TEXT("……我會好好問他的。"), TEXT("...I'll make sure to ask him properly.") },
{ TEXT("去吧。天門之夜，時辰將至。"), TEXT("Go. The Night of the Heaven's Gate is nearly here.") },
{ TEXT("金克木，箭穿五行。……卦象誠不我欺。"), TEXT("Metal cuts wood, and your arrow pierced the five elements. ...The divination did not lie.") },
{ TEXT("天宮怎麼走。"), TEXT("How do I get to the Heavenly Palace?") },
{ TEXT("往上。雲會為你讓路。"), TEXT("Upward. The clouds will part for you.") },
{ TEXT("你們甘心當棋？"), TEXT("You're content being pieces?") },
{ TEXT("棋盤若毀，便無所謂棋子。我們只是選了能守住棋盤的那一步。"), TEXT("If the board is destroyed, there are no pieces. We only chose the move that keeps the board whole.") },
{ TEXT("……我不喜歡被人下。但這一步，我走。"), TEXT("...I don't like being played. But this move, I'll make.") },
{ TEXT("五行皆盡。你現在，比剛才更餓了吧？"), TEXT("The five elements are spent. You're even hungrier than before, aren't you?") },
{ TEXT("對！肚子在叫！"), TEXT("Yes! My stomach's growling!") },
{ TEXT("那是五份力量在你體內打轉。上天宮去吧，燁……大概會請你吃飯。"), TEXT("That's five powers swirling inside you. Go up to the Heavenly Palace. Yoh will... probably treat you to a meal.") },
{ TEXT("真的嗎！？"), TEXT("Really?!") },
{ TEXT("卦象沒說。但若結界補好，大家都能好好吃飯。"), TEXT("The divination didn't say. But if the barrier is mended, everyone will be able to eat in peace.") },
{ TEXT("那就更要去了！"), TEXT("Then I definitely have to go!") },
{ TEXT("五行相生，最後都流向了你。"), TEXT("The five elements feed one another, and in the end they all flowed to you.") },
{ TEXT("孩子們說，這些力量……好重。"), TEXT("The children say these powers... are so heavy.") },
{ TEXT("那是結界的重量。燁一個人扛了好幾百年。"), TEXT("That is the weight of the barrier. Yoh has carried it alone for hundreds of years.") },
{ TEXT("一個人……"), TEXT("Alone...") },
{ TEXT("上天宮吧，人偶師。你和你的孩子們，或許能替他分擔。"), TEXT("Go up to the Heavenly Palace, puppeteer. You and your children may be able to share his burden.") },
{ TEXT("……嗯。我們一起去。"), TEXT("...Yes. We'll go together.") },
{ TEXT("燁"), TEXT("Yoh") },
{ TEXT("四神的守護者"), TEXT("Guardian of the Four Gods") },
{ TEXT("第六面"), TEXT("Stage 6") },
{ TEXT("天宮"), TEXT("Heavenly Palace") },
{ TEXT("東方「青龍天昇」"), TEXT("East \"Azure Dragon Ascends\"") },
{ TEXT("西方「白虎嘯風」"), TEXT("West \"Roar of the White Tiger\"") },
{ TEXT("南方「朱雀焚天」"), TEXT("South \"Vermilion Bird Burns the Sky\"") },
{ TEXT("北方「玄武鎮海」"), TEXT("North \"Black Tortoise Calms the Sea\"") },
{ TEXT("四神奧義「四象歸一」"), TEXT("Four Gods Secret Art \"Four Symbols Become One\"") },
{ TEXT("走到這裡的人，你是第一個。"), TEXT("You are the first to make it this far.") },
{ TEXT("你就是燁吧！大家的異變，全是你在背後安排的！"), TEXT("You're Yoh! You were behind everyone's incidents!") },
{ TEXT("是的。四神結界撐不過今晚的天門之夜，而我已經沒有力量補上它。"), TEXT("Yes. The Four Gods Barrier will not survive tonight's Night of the Heaven's Gate, and I no longer have the strength to mend it.") },
{ TEXT("那為什麼不直接說！為什麼要讓天狼、千秋、嵐、墨竹、玄去鬧事？"), TEXT("Then why not just say so! Why make Tenrou, Chiaki, Arashi, Bokuchiku and Gen cause trouble?") },
{ TEXT("結界之力只承認「勝者」。我離不開天宮，只能讓五位守門人各執一份力量，等待有人一一勝過他們。"), TEXT("The barrier's power only acknowledges a \"victor\". I cannot leave the Heavenly Palace, so I had five gatekeepers each hold one power, and waited for someone to defeat them one by one.") },
{ TEXT("……那些力量，現在全在我身上。"), TEXT("...And all of that power is in me now.") },
{ TEXT("沒錯。我對他們、對村子都感到抱歉。但若結界崩毀，失去的將不只是星星和季節。"), TEXT("Yes. I am sorry, to them and to the villages. But if the barrier falls, far more than stars and seasons will be lost.") },
{ TEXT("我才不要什麼繼承！我只要大家能好好過日子！"), TEXT("I don't want any inheritance! I just want everyone to live in peace!") },
{ TEXT("正是這份心，才配得上這些力量。最後一次——以四神之力試你。"), TEXT("That heart is exactly what makes you worthy of this power. One last time, I will test you with the might of the Four Gods.") },
{ TEXT("好！打完以後，你得親口跟大家道歉！"), TEXT("Fine! And when it's over, you're apologising to everyone yourself!") },
{ TEXT("弓手，你一路射穿了所有考驗。"), TEXT("Archer, you have shot through every trial.") },
{ TEXT("考驗？害那麼多人困擾，就為了這個？"), TEXT("Trials? You troubled that many people just for this?") },
{ TEXT("天門之夜就在今晚。四神結界已經碎了一半，而我快撐不住了。"), TEXT("The Night of the Heaven's Gate is tonight. The Four Gods Barrier is already half broken, and I can barely hold on.") },
{ TEXT("所以你讓五個人鬧事，讓我把他們的力量一一搶過來。"), TEXT("So you had five people cause trouble, and let me take their power one by one.") },
{ TEXT("結界之力只追隨勝者。我無法下凡，只能這樣做。"), TEXT("The barrier's power only follows a victor. I cannot descend, so this was the only way.") },
{ TEXT("自私。"), TEXT("Selfish.") },
{ TEXT("我承認。這份罪，我會在結界補好之後承擔。"), TEXT("I admit it. I will answer for this once the barrier is mended.") },
{ TEXT("……那就快點結束。"), TEXT("...Then let's get it over with.") },
{ TEXT("好。四神為證——讓我看看你的箭，能否抵達天頂！"), TEXT("Very well. With the Four Gods as witness, let me see whether your arrow can reach the zenith!") },
{ TEXT("我說過了。我只需要一箭。"), TEXT("I told you. I only need one arrow.") },
{ TEXT("修行者，歡迎來到天宮。"), TEXT("Traveller, welcome to the Heavenly Palace.") },
{ TEXT("哇～好漂亮！這裡有供品可以吃嗎？……不對，我是來罵你的！"), TEXT("Wow~ So pretty! Are there any offerings to eat? ...No wait, I came to scold you!") },
{ TEXT("罵我？"), TEXT("Scold me?") },
{ TEXT("你讓大家做奇怪的夢、亂搞星星跟季節，害村子好慘！"), TEXT("You gave everyone weird dreams and messed up the stars and seasons, and the villages had an awful time!") },
{ TEXT("……是的。四神結界今晚就會碎裂，而我已無力修補。結界之力只追隨勝者，我只能讓守門人們各執一份，等人來取。"), TEXT("...Yes. The Four Gods Barrier shatters tonight, and I can no longer mend it. Its power only follows a victor, so I had the gatekeepers each hold a share, and waited for someone to take them.") },
{ TEXT("所以我一路吃苦，都是在幫你搬東西喔？"), TEXT("So all my hard work was just hauling your stuff?") },
{ TEXT("呵……可以這麼說。你背上的五份力量，足以補上結界。但我必須確認，你承受得住。"), TEXT("Heh... You could say that. The five powers on your back are enough to mend the barrier. But I must be sure you can bear them.") },
{ TEXT("那打完以後，你要請大家吃飯喔，五個守門人都要！"), TEXT("Then after this, you're treating everyone to dinner. All five gatekeepers too!") },
{ TEXT("一言為定。來吧，接受四神的最後試煉！"), TEXT("It's a promise. Come, face the final trial of the Four Gods.") },
{ TEXT("說好了喔～開飯前的運動！"), TEXT("Deal~ A little exercise before dinner!") },
{ TEXT("安靜的孩子。你的人偶，陪你走過了每一關。"), TEXT("A quiet child. Your puppets have walked every stage with you.") },
{ TEXT("是的……它們說，您看起來很寂寞。"), TEXT("Yes... They say you look very lonely.") },
{ TEXT("守護四方的人，本就孤身一人。如今，我連守護也快做不到了。"), TEXT("One who guards the four quarters is alone by nature. And now I can barely even guard.") },
{ TEXT("所以您發出了天啟，讓大家引起異變。"), TEXT("So you sent the revelations, and made everyone cause incidents.") },
{ TEXT("結界之力只追隨勝者。我讓五人各守一份，等待有人一一贏過他們——那就是你。"), TEXT("The barrier's power only follows a victor. I had five people each guard a share, and waited for someone to defeat them one by one. That someone is you.") },
{ TEXT("天狼先生、千秋先生、嵐先生、墨竹先生、玄先生……大家其實都不是壞人。"), TEXT("Mr. Tenrou, Mr. Chiaki, Mr. Arashi, Mr. Bokuchiku, Mr. Gen... none of them are actually bad people.") },
{ TEXT("是我讓他們背了罪名。等結界修好，我會親自向他們謝罪。"), TEXT("I made them carry the blame. Once the barrier is mended, I will apologise to them myself.") },
{ TEXT("那麼……請讓孩子們，也陪陪您吧。"), TEXT("Then... please let the children keep you company too.") },
{ TEXT("……溫柔的回答。那就以四神之力，最後一次試你！"), TEXT("...A kind answer. Then with the might of the Four Gods, I will test you one last time!") },
{ TEXT("孩子們，最後一場了。"), TEXT("Children, this is the last battle.") },
{ TEXT("……勝負已分。四神的力量，現在都屬於你了。"), TEXT("...It is decided. The power of the Four Gods now belongs to you.") },
{ TEXT("那結界呢？補得回來嗎？"), TEXT("What about the barrier? Can it be fixed?") },
{ TEXT("已經在補了。你每贏一場，結界就穩一分。天門之夜，會平安過去。"), TEXT("It is already mending. Each time you won, it grew a little steadier. The Night of the Heaven's Gate will pass safely.") },
{ TEXT("那你呢？你會消失嗎？"), TEXT("And you? Are you going to disappear?") },
{ TEXT("力量交出去了，我也終於能休息。不必擔心，守護者不會死，只是睡去。"), TEXT("With the power handed over, I can finally rest. Don't worry. A guardian does not die, he only sleeps.") },
{ TEXT("……下次有事，直接說！不要再讓大家打架了！"), TEXT("...Next time something's wrong, just say it! Don't make everyone fight again!") },
{ TEXT("哈……是。我答應你。"), TEXT("Ha... Yes. I promise.") },
{ TEXT("好箭。……結界已經穩住了。"), TEXT("A fine arrow. ...The barrier is steady now.") },
{ TEXT("你利用了五個人。"), TEXT("You used five people.") },
{ TEXT("是。這份罪，我會記著。"), TEXT("Yes. I will remember that sin.") },
{ TEXT("……不必。他們都知道，還是選了這條路。"), TEXT("...No need. They all knew, and still chose this path.") },
{ TEXT("你比看起來溫柔。"), TEXT("You are kinder than you look.") },
{ TEXT("少囉嗦。快去睡吧，守護者。"), TEXT("Quiet. Go get some sleep, guardian.") },
{ TEXT("……結束了。天門之夜，平安無事。"), TEXT("...It's over. The Night of the Heaven's Gate passed without harm.") },
{ TEXT("太好了！那可以吃飯了嗎？"), TEXT("Great! So can we eat now?") },
{ TEXT("……你一路打上天宮，就為了這個？"), TEXT("...You fought all the way up to the Heavenly Palace for that?") },
{ TEXT("還有大家！天狼、千秋、嵐、墨竹、玄，大家都很擔心你耶。還有我！"), TEXT("And for everyone! Tenrou, Chiaki, Arashi, Bokuchiku, Gen, they were all worried about you. Me too!") },
{ TEXT("……是嗎。原來，我不是一個人在守。"), TEXT("...Is that so. So I was never guarding alone.") },
{ TEXT("所以啦，下次一起吃飯！"), TEXT("So, next time we eat together!") },
{ TEXT("好。下次，一起。"), TEXT("Yes. Next time, together.") },
{ TEXT("人偶師……謝謝你。結界穩住了。"), TEXT("Puppeteer... thank you. The barrier is steady.") },
{ TEXT("孩子們說，你的聲音不再寂寞了。"), TEXT("The children say your voice isn't lonely anymore.") },
{ TEXT("五百年來，我一直以為只能靠自己。原來，還能把重量分出去。"), TEXT("For five hundred years I thought I could only rely on myself. It turns out the weight can be shared.") },
{ TEXT("分給大家吧。我們都在。"), TEXT("Share it with everyone. We're all here.") },
{ TEXT("……嗯。那就拜託了，新的守護者。"), TEXT("...Yes. Then I leave it to you, new guardian.") },
{ TEXT("孩子們，我們有新的工作了。"), TEXT("Children, we have a new job.") },
{ TEXT("逆符「五行逆轉」"), TEXT("Reverse Sign \"Five Elements Reversed\"") },
{ TEXT("數符「河圖洛書」"), TEXT("Number Sign \"River Chart and Luo Writing\"") },
{ TEXT("陣符「八門金鎖」"), TEXT("Formation Sign \"Golden Lock of the Eight Gates\"") },
{ TEXT("又見面了。結界補好了，你卻還往上走。"), TEXT("We meet again. The barrier is mended, and still you climb higher.") },
{ TEXT("天宮後面還有路！那裡有什麼？"), TEXT("There's a path behind the Heavenly Palace! What's up there?") },
{ TEXT("「天和閣」。主人叫一索——五百年前，從燁手上贏走了十三枚天印的男人。"), TEXT("The \"Tenhou Pavilion\". Its master is Iisou, the man who won thirteen Heaven Seals from Yoh five hundred years ago.") },
{ TEXT("十三枚天印？"), TEXT("Thirteen Heaven Seals?") },
{ TEXT("結界最初的裂痕，就是從那時開始的。他從不輸牌，你的力量再強，也得照他的規矩來。"), TEXT("That is when the barrier's first crack appeared. He never loses at tiles. However strong you are, you will have to play by his rules.") },
{ TEXT("我才不怕規矩！"), TEXT("I'm not afraid of rules!") },
{ TEXT("勸你在此撤退，這是最好的卦。……不聽的話，就先過我這三卦吧。"), TEXT("I advise you to turn back here. That is the best reading. ...If you won't listen, first pass my three readings.") },
{ TEXT("又見面了。你的箭，還想往哪裡射？"), TEXT("We meet again. Where do you mean to shoot next?") },
{ TEXT("天宮後面。那裡有人。"), TEXT("Behind the Heavenly Palace. Someone's there.") },
{ TEXT("天和閣的一索。他手上握著十三枚天印——結界缺的最後一塊。"), TEXT("Iisou of the Tenhou Pavilion. He holds thirteen Heaven Seals, the last piece the barrier is missing.") },
{ TEXT("那就拿回來。"), TEXT("Then I'll take them back.") },
{ TEXT("他不是靠力量能打倒的人。他的規矩，連燁都贏不了。撤退吧，這是忠告。"), TEXT("He is not someone you defeat with strength. Even Yoh couldn't beat his rules. Turn back. That is my advice.") },
{ TEXT("不。"), TEXT("No.") },
{ TEXT("……果然。那就讓我用三卦，看你有沒有資格。"), TEXT("...As expected. Then let my three readings judge whether you are worthy.") },
{ TEXT("山伏，你怎麼又來了？"), TEXT("Mountain monk, why are you here again?") },
{ TEXT("燁說要請客，我在找廚房～結果走到這裡來了。"), TEXT("Yoh said he'd treat us, so I was looking for the kitchen~ and ended up here.") },
{ TEXT("這裡往前是天和閣。主人一索，愛賭成性，五百年前從燁手上贏走十三枚天印。"), TEXT("Ahead lies the Tenhou Pavilion. Its master, Iisou, loves to gamble. Five hundred years ago he won thirteen Heaven Seals from Yoh.") },
{ TEXT("天印？可以吃嗎？"), TEXT("Heaven Seals? Can I eat them?") },
{ TEXT("……不能。結界的裂痕就是從那時開始的。他從不輸，連燁都敗給他。勸你撤退。"), TEXT("...No. The barrier's crack began back then. He never loses; even Yoh lost to him. I advise you to turn back.") },
{ TEXT("可是燁說他請客，那個一索搞不好也有好吃的！"), TEXT("But Yoh said he's treating us, so that Iisou might have good food too!") },
{ TEXT("唉……那就讓我用三卦，試試你的胃口。"), TEXT("Sigh... Then let my three readings test your appetite.") },
{ TEXT("人偶師，結界已經補好，你為何還往前走？"), TEXT("Puppeteer, the barrier is mended. Why do you keep going?") },
{ TEXT("孩子們說，前面還有一個發光的地方，在叫我們。"), TEXT("The children say there's another shining place up ahead, calling to us.") },
{ TEXT("天和閣。主人一索，五百年前與燁對賭，贏走了十三枚天印。"), TEXT("The Tenhou Pavilion. Its master Iisou gambled with Yoh five hundred years ago and won thirteen Heaven Seals.") },
{ TEXT("十三枚……那就是結界最初的裂痕嗎？"), TEXT("Thirteen... Is that the barrier's very first crack?") },
{ TEXT("不錯。但他從不輸牌。以你的溫柔，恐怕會被他的規矩吞掉。撤退吧。"), TEXT("Indeed. But he never loses at tiles. With your gentleness, I fear his rules will swallow you. Turn back.") },
{ TEXT("……孩子們想見他。"), TEXT("...The children want to meet him.") },
{ TEXT("那就先讓我用三卦，看看人偶的覺悟。"), TEXT("Then first let my three readings see the puppets' resolve.") },
{ TEXT("一索"), TEXT("Iisou") },
{ TEXT("役滿的雀聖"), TEXT("Mahjong Saint of the Yakuman") },
{ TEXT("雀莊・天和閣"), TEXT("Mahjong Parlour: Tenhou Pavilion") },
{ TEXT("立直「立直一發」"), TEXT("Riichi \"Riichi Ippatsu\"") },
{ TEXT("平和「平和斷么」"), TEXT("Pinfu \"Pinfu Tanyao\"") },
{ TEXT("一色「清一色」"), TEXT("One Suit \"Chinitsu\"") },
{ TEXT("對子「七對子」"), TEXT("Pairs \"Seven Pairs\"") },
{ TEXT("開花「嶺上開花」"), TEXT("Bloom \"After a Kong\"") },
{ TEXT("役滿一「大三元」"), TEXT("Yakuman I \"Big Three Dragons\"") },
{ TEXT("役滿二「大四喜」"), TEXT("Yakuman II \"Big Four Winds\"") },
{ TEXT("役滿三「九蓮寶燈」"), TEXT("Yakuman III \"Nine Gates\"") },
{ TEXT("役滿奧義「國士無雙」"), TEXT("Yakuman Secret Art \"Thirteen Orphans\"") },
{ TEXT("終局「天和」"), TEXT("Final Hand \"Tenhou\"") },
{ TEXT("喲，通關的小哥！玄那傢伙沒把你攔住啊。"), TEXT("Hey there, the hero who cleared the game! Gen couldn't stop you, huh?") },
{ TEXT("你就是一索！把十三枚天印還給燁！"), TEXT("You're Iisou! Give the thirteen Heaven Seals back to Yoh!") },
{ TEXT("還？我可是贏來的。五百年前，那個認真過頭的守護者，想用天印賭我的「不敗之運」。"), TEXT("Give them back? I won them fair and square. Five hundred years ago that overly serious guardian bet the seals against my \"unbeatable luck\".") },
{ TEXT("他為什麼要賭那種東西？"), TEXT("Why would he bet on something like that?") },
{ TEXT("他想要一份永遠不輸的運氣，去守永遠不能輸的結界。結果他輸了——所以結界才開始裂。"), TEXT("He wanted luck that never loses, to guard a barrier that must never fall. Then he lost, and that's when the barrier started to crack.") },
{ TEXT("那你明明知道，還一直留著！"), TEXT("You knew all that, and you kept them anyway!") },
{ TEXT("我留著，是因為他一直不肯好好休息。沒有天印，他才會去找繼承人。……你看，他不就找到你了？"), TEXT("I kept them because he never would rest. Without the seals, he'd have to go find a successor. ...And look, didn't he find you?") },
{ TEXT("……這是什麼歪理！"), TEXT("...What kind of logic is that!") },
{ TEXT("規矩很簡單：贏我一局，十三枚全給你。來，開局！"), TEXT("The rules are simple: beat me in one game and all thirteen are yours. Come, let's deal!") },
{ TEXT("冷著一張臉，不錯，很適合打牌。"), TEXT("A cold, straight face. Nice. Perfect for cards.") },
{ TEXT("我不賭。天印還來。"), TEXT("I don't gamble. Return the seals.") },
{ TEXT("人生就是一場賭局。燁當年賭輸了天印，結界才開始裂。"), TEXT("Life is one big gamble. Yoh lost the seals back then, and the barrier began to crack.") },
{ TEXT("你明知道，還不還。"), TEXT("You knew that, and still didn't return them.") },
{ TEXT("因為那傢伙會把自己燒乾。沒了天印，他才終於肯找人接手——找到的就是你。"), TEXT("Because that guy would have burned himself out. Without the seals he finally agreed to find someone to take over. And the one he found was you.") },
{ TEXT("所以你也算計了。"), TEXT("So you were scheming too.") },
{ TEXT("我只是坐在牌桌前等。來吧，你射出每一箭時，不也在賭？"), TEXT("I just sat at the table and waited. Come on, isn't every arrow you loose a gamble too?") },
{ TEXT("……我從不射偏。"), TEXT("...I never miss.") },
{ TEXT("哈哈！那就讓我看看，你能不能聽牌到最後！"), TEXT("Haha! Then let's see if you can stay in tenpai to the very end!") },
{ TEXT("山伏也來雀莊？輸了可是要請客的喔。"), TEXT("A mountain monk in a mahjong parlour? Lose, and you're buying dinner.") },
{ TEXT("好啊～贏了你請我吃一桌！還有，天印要還給燁喔。"), TEXT("Sure~ If I win, you treat me to a whole table! Oh, and give the seals back to Yoh.") },
{ TEXT("喔？玄都告訴你了。那是五百年前燁輸給我的。他想用天印換我的「不敗之運」。"), TEXT("Oh? So Gen told you everything. Yoh lost them to me five hundred years ago. He wanted to trade them for my \"unbeatable luck\".") },
{ TEXT("為什麼？"), TEXT("Why?") },
{ TEXT("那個死腦筋想永遠不輸地守著結界。可是一個人怎麼可能永遠不輸？輸了，才會找人幫忙。"), TEXT("That blockhead wanted to guard the barrier forever without ever losing. But how can one person never lose? Only after losing would he ask for help.") },
{ TEXT("嗯～所以你是故意不還，好讓他找幫手？"), TEXT("Hmm~ So you didn't give them back on purpose, so he'd find helpers?") },
{ TEXT("誰知道呢。總之規矩是：贏我，十三枚全給你。"), TEXT("Who knows. Anyway, the rule is: beat me, and all thirteen are yours.") },
{ TEXT("那就說好了，十三枚天印，加十三道菜！"), TEXT("Then it's a deal: thirteen Heaven Seals, plus thirteen dishes!") },
{ TEXT("十三？巧了，我也有十三張牌要給你看——國士無雙！"), TEXT("Thirteen? What a coincidence, I have thirteen tiles to show you too. Thirteen Orphans!") },
{ TEXT("小朋友，帶著人偶來打牌？"), TEXT("Little one, you brought puppets to play mahjong?") },
{ TEXT("孩子們想看您打牌……它們說，您的牌在發光。"), TEXT("The children wanted to watch you play... They say your tiles are glowing.") },
{ TEXT("好眼光！這十三張，是五百年前從燁手上贏來的天印。"), TEXT("Good eye! These thirteen are the Heaven Seals I won from Yoh five hundred years ago.") },
{ TEXT("結界的裂痕……是從那時開始的吧。"), TEXT("The barrier's crack... started back then, didn't it?") },
{ TEXT("是啊。那傢伙想用天印換我的運氣，好一個人守到永遠。他輸了，我就把天印留下了。"), TEXT("It did. That guy wanted to trade the seals for my luck so he could guard alone forever. He lost, so I kept the seals.") },
{ TEXT("您是怕他……一直一個人嗎？"), TEXT("Were you afraid he'd... always be alone?") },
{ TEXT("……人偶師，你看得太清楚了。沒錯，沒了天印，他才肯找人來分擔。"), TEXT("...Puppeteer, you see too clearly. Yes. Without the seals, he finally agreed to find people to share the load.") },
{ TEXT("那麼，請讓孩子們把天印帶回去吧。"), TEXT("Then please let the children take the seals home.") },
{ TEXT("哈！有意思。那就開局吧，贏了我，九蓮寶燈都給你看！"), TEXT("Ha! Interesting. Then let's deal. Beat me and I'll even show you the Nine Gates!") },
{ TEXT("哈哈哈！和了！不對，是你和了。十三枚天印，拿去吧。"), TEXT("Hahaha! Mahjong! No, wait, you won. The thirteen Heaven Seals are yours.") },
{ TEXT("……這麼乾脆？"), TEXT("...Just like that?") },
{ TEXT("賭品要好。而且，我等的就是這一天。"), TEXT("A good gambler loses gracefully. Besides, this is the day I've been waiting for.") },
{ TEXT("等什麼？"), TEXT("Waiting for what?") },
{ TEXT("等燁找到可以信任的人。天印回到結界，最初的裂痕也補上了——五百年的牌局，終於結束。"), TEXT("For Yoh to find someone he can trust. The seals return to the barrier and the first crack is mended. A five-hundred-year game, finally over.") },
{ TEXT("你其實一直在幫他吧。"), TEXT("You've been helping him all along, haven't you.") },
{ TEXT("誰知道呢？下次記得帶燁來打牌，三缺一啊。"), TEXT("Who knows? Next time bring Yoh over for a game. We're one player short.") },
{ TEXT("漂亮。每一箭都聽牌，每一箭都和了。"), TEXT("Beautiful. Every arrow in tenpai, every arrow a winning hand.") },
{ TEXT("天印。"), TEXT("The seals.") },
{ TEXT("拿去拿去。十三枚，一枚不少。"), TEXT("Take them, take them. Thirteen, not one missing.") },
{ TEXT("你早就打算還了。"), TEXT("You meant to give them back all along.") },
{ TEXT("我只是在等一個值得還的人。燁那傢伙，終於學會依靠別人了。"), TEXT("I was just waiting for someone worth giving them to. That guy Yoh finally learned to rely on others.") },
{ TEXT("……你們兩個，都很麻煩。"), TEXT("...You two are both a pain.") },
{ TEXT("哈哈！這句我收下了。改天來打牌吧！"), TEXT("Haha! I'll take that as a compliment. Come play a game sometime!") },
{ TEXT("輸了輸了！說好的，十三枚天印……還有十三道菜！"), TEXT("I lose, I lose! As promised, thirteen Heaven Seals... and thirteen dishes!") },
{ TEXT("耶～！真的有菜嗎？"), TEXT("Yay~! There's really food?") },
{ TEXT("當然，天和閣的廚房可是天界第一。"), TEXT("Of course. The Tenhou Pavilion's kitchen is the best in heaven.") },
{ TEXT("那燁也一起來吧！他一定很久沒好好吃飯了。"), TEXT("Then bring Yoh along too! I bet he hasn't had a proper meal in ages.") },
{ TEXT("……你這山伏，總是說中要害。好，把他也拖來。"), TEXT("...You mountain monk, you always hit the mark. Fine, I'll drag him along.") },
{ TEXT("說好了喔！十三道菜，一道都不能少！"), TEXT("It's a promise! Thirteen dishes, not one less!") },
{ TEXT("你贏了，人偶師。十三枚天印，請帶回去吧。"), TEXT("You win, puppeteer. Please take the thirteen Heaven Seals home.") },
{ TEXT("謝謝您……孩子們說，您其實很捨不得。"), TEXT("Thank you... The children say you're actually sad to part with them.") },
{ TEXT("捨不得？哈……是啊。這些天印陪了我五百年。"), TEXT("Sad to part with them? Ha... Yes. These seals kept me company for five hundred years.") },
{ TEXT("那，您可以來天宮看它們。和燁一起。"), TEXT("Then you can come to the Heavenly Palace to see them. Together with Yoh.") },
{ TEXT("……你真是溫柔得可怕。好，就這麼說定了。"), TEXT("...You're frighteningly kind. All right, it's settled.") },
{ TEXT("孩子們，回家吧。天印也一起。"), TEXT("Children, let's go home. The seals are coming too.") },

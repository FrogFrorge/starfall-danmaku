{ TEXT("超寬雷射縱向清場，持續傷害"), TEXT("A huge vertical laser clears its column and keeps burning") },
{ TEXT("晴"), TEXT("Haru") },
{ TEXT("追蹤型"), TEXT("Homing Type") },

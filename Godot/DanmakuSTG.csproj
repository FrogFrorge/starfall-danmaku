<Project Sdk="Godot.NET.Sdk/4.6.1">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>DanmakuSTG</RootNamespace>
    <LangVersion>12</LangVersion>
    <Nullable>disable</Nullable>
    <!-- ported C++ uses lots of locals named like types and unused results; keep the build quiet -->
    <NoWarn>$(NoWarn);CS0168;CS0219;CS0162;CS0414;CS0649;CS8981</NoWarn>
  </PropertyGroup>
</Project>
